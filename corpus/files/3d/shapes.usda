#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Sphere "Ball"
    {
        double radius = 1
        double3 xformOp:translate = (-3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Box"
    {
        double size = 2
    }

    def Cone "Spike"
    {
        double radius = 1
        double height = 2
        uniform token axis = "Y"
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "Pill"
    {
        double radius = 0.5
        double height = 1
        uniform token axis = "Y"
        double3 xformOp:translate = (0, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def BasisCurves "Line"
    {
        uniform token type = "linear"
        int[] curveVertexCounts = [3]
        point3f[] points = [(-3, -3, 0), (0, -2, 0), (3, -3, 0)]
    }

    def Points "Dots"
    {
        point3f[] points = [(-3, 3, 0), (3, 3, 0)]
    }
}
